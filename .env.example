# ==============================================================================
# NEO STUDIO AI — VERCEL ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Anda dapat memasukkan satu API key ATAU multi-key dipisahkan dengan koma (,)
# Format Multi-Key: "key1, key2, key3"
# Sistem otomatis melakukan Round-Robin dan Failover/Rotasi saat terkena limit (429).
# ==============================================================================

# --- 1. GOOGLE GEMINI API (Multi-Key didukung) ---
# Gunakan untuk Story, Script, Storyboard, Imagen 3, Veo 2
GEMINI_API_KEY="AIzaSy_KEY1, AIzaSy_KEY2, AIzaSy_KEY3"

# --- 2. NVIDIA NIM API (Multi-Key didukung) ---
# Gunakan untuk Deep Reasoning Llama 3.1 70B & DeepSeek R1
NVIDIA_API_KEY="nvapi-KEY1, nvapi-KEY2"
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# --- 3. CLOUDFLARE WORKERS AI (Multi-Key & Multi-Account didukung) ---
# Gunakan untuk Edge Text, FLUX.1 Schnell, Aura TTS
# Format berpasangan urut: key1 ↔ idakun1, key2 ↔ idakun2, dst.
CLOUDFLARE_API_KEY="token_1, token_2, token_3"
CLOUDFLARE_ACCOUNT_ID="idakun1, idakun2, idakun3"

# --- 4. GROQ API (Multi-Key didukung) ---
# Gunakan untuk Inferensi Super Cepat (>300 tps) Llama 3.3 70B & Whisper STT
GROQ_API_KEY="gsk_KEY1, gsk_KEY2, gsk_KEY3"
# GROQ_BASE_URL="https://api.groq.com/openai/v1"

# --- 5. OPENROUTER API (Multi-Key didukung) ---
# Gunakan untuk Unified Multi-Model Gateway (DeepSeek R1, Claude 3.5 Sonnet, Llama 3.3, Gemini 2.0)
OPENROUTER_API_KEY="sk-or-v1-key1, sk-or-v1-key2, sk-or-v1-key3"
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# --- 6. OLLAMA API (Remote Server / Local dengan Auth) ---
# Jika di-deploy ke Vercel, jangan gunakan localhost. Gunakan URL publik atau Cloudflare Tunnel.
OLLAMA_BASE_URL="https://ollama.your-domain.com"
OLLAMA_API_KEY="optional_bearer_token1, optional_bearer_token2"
